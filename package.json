{
    "name": "tanstart",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://github.com/riipandi/tanstart#readme",
    "bugs": {
        "url": "https://github.com/riipandi/tanstart/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/riipandi/tanstart.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy",
        "start": "PORT=3000 node --env-file-if-exists=.env.local ./dist/server/server.js",
        "typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "cleanup": "pnpm --silent cleanup:dist && pnpm --silent cleanup:deps",
        "cleanup:dist": "pnpm dlx del-cli dist storybook-static e2e-result",
        "cleanup:deps": "pnpm dlx del-cli .{tanstack,wrangler} pnpm-lock.yaml node_modules",
        "generate:key": "openssl rand -hex 32",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build",
        "storybook:start": "pnpm dlx serve storybook-static -l 6006 -S -n -C",
        "e2e-install": "playwright install chromium --with-deps",
        "e2e-chrome": "playwright test --headed --project Chromium",
        "e2e-firefox": "playwright test --headed --project Firefox",
        "e2e-mobile": "playwright test --headed --project 'Mobile Chrome'",
        "e2e-safari": "playwright test --headed --project Safari",
        "e2e-report": "playwright show-report e2e-result",
        "e2e-ui": "playwright test --ui",
        "e2e": "playwright test",
        "test:report": "pnpm dlx serve output/test-result -l 8000 -s -n -C",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test": "vitest --run",
        "knip": "knip -c .knip.jsonc --reporter markdown --no-exit-code",
        "format": "oxfmt --write .",
        "check": "oxfmt --check",
        "lint": "oxlint --fix .",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@stylexjs/stylex": "^0.19.1",
        "@tanstack/react-form": "^1.33.5",
        "@tanstack/react-query": "^5.104.2",
        "@tanstack/react-router": "^1.170.44",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.169.1",
        "@tanstack/react-store": "^0.11.2",
        "@tanstack/router-plugin": "^1.168.45",
        "lucide-react": "^1.56.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.63.2",
        "@stylexjs/eslint-plugin": "^0.19.1",
        "@stylexjs/unplugin": "^0.19.1",
        "@tanstack/devtools-vite": "^0.8.5",
        "@tanstack/react-devtools": "^0.10.13",
        "@tanstack/react-query-devtools": "^5.104.2",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-plugin": "^1.168.45",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.4",
        "dotenv-cli": "^11.0.0",
        "jsdom": "^30.1.2",
        "kill-port-process-cli": "^1.0.16",
        "knip": "^6.41.0",
        "npm-check-updates": "^23.1.1",
        "oxc-transform-react": "^0.154.0",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.88.0",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.4",
        "wrangler": "^4.150.0"
    },
    "config": {
        "image": "ghcr.io/riipandi/tanstart"
    },
    "engines": {
        "node": ">=24.12.0"
    },
    "packageManager": "pnpm@12.11.2"
}
