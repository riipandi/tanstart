{
    "name": "tanstart",
    "version": "0.0.0",
    "private": true,
    "homepage": "https://github.com/riipandi/tanstart#readme",
    "bugs": {
        "url": "https://github.com/riipandi/tanstart/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/riipandi/tanstart.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy",
        "start": "PORT=3000 node --env-file-if-exists=.env.local ./dist/server/server.js",
        "typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "update-deps": "npm-check-updates --configFileName .ncurc.json",
        "cleanup": "pnpm --silent cleanup:dist && pnpm --silent cleanup:deps",
        "cleanup:dist": "pnpm dlx del-cli dist storybook-static e2e-result",
        "cleanup:deps": "pnpm dlx del-cli .{tanstack,wrangler} pnpm-lock.yaml node_modules",
        "generate:key": "openssl rand -hex 32",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build",
        "storybook:start": "pnpm dlx serve storybook-static -l 6006 -S -n -C",
        "e2e-install": "playwright install chromium --with-deps",
        "e2e-chrome": "playwright test --headed --project Chromium",
        "e2e-firefox": "playwright test --headed --project Firefox",
        "e2e-mobile": "playwright test --headed --project 'Mobile Chrome'",
        "e2e-safari": "playwright test --headed --project Safari",
        "e2e-report": "playwright show-report e2e-result",
        "e2e-ui": "playwright test --ui",
        "e2e": "playwright test",
        "test:report": "pnpm dlx serve output/test-result -l 8000 -s -n -C",
        "test:coverage": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "test": "vitest --run",
        "knip": "knip -c .knip.jsonc --reporter markdown --no-exit-code",
        "format": "oxfmt --write .",
        "check": "oxfmt --check",
        "lint": "oxlint --fix .",
        "typecheck": "tsc -b --noEmit"
    },
    "dependencies": {
        "@lonik/themer": "^0.5.4",
        "@tanstack/react-form": "^1.33.1",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-router": "^1.170.17",
        "@tanstack/react-router-ssr-query": "^1.167.1",
        "@tanstack/react-start": "^1.168.27",
        "@tanstack/react-store": "^0.11.0",
        "@tanstack/router-plugin": "^1.168.19",
        "lucide-react": "^1.24.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tailwind-merge": "^3.6.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.3.2",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.44.0",
        "@tailwindcss/vite": "^4.3.2",
        "@tanstack/devtools-vite": "^0.8.1",
        "@tanstack/react-devtools": "^0.10.8",
        "@tanstack/react-query-devtools": "^5.101.2",
        "@tanstack/react-router-devtools": "^1.167.0",
        "@tanstack/router-plugin": "^1.168.19",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.10",
        "dotenv-cli": "^11.0.0",
        "jsdom": "^29.1.1",
        "kill-port-process-cli": "^1.0.16",
        "knip": "^6.26.0",
        "npm-check-updates": "^22.2.9",
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0",
        "typescript": "^7.0.2",
        "vite": "^8.1.4",
        "vitest": "^4.1.10",
        "wrangler": "^4.110.0"
    },
    "config": {
        "image": "ghcr.io/riipandi/tanstart"
    },
    "engines": {
        "node": ">=24.12.0"
    },
    "packageManager": "pnpm@11.11.0"
}
